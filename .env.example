[TEMPLATE]
# Placeholder names only — no values, no keys, ever committed (STANDARDS §2).
#
# The app reads real environment variables; it does NOT read this file. Export them in your shell,
# or point a tool that loads .env (direnv, an IDE run configuration) at a copy of this. .env itself is
# gitignored.
#
# Everything below is optional. Transcription, the rule-based formatter, the exporters and the eval
# run with no key, no account and no network.

## Read by the app (GeminiFormatter G3, screenshot Q&A G4)

# Empty or unset = both online features stay off. The CLI refuses `--format gemini` in that case
# (exit 1) instead of quietly pretending; the UI falls back to the rule-based formatter and says so.
GEMINI_API_KEY=

# Model id, set by the operator rather than guessed. Default: gemini-2.5-flash
SPEECH_NOTES_GEMINI_MODEL=

# Hard per-run caps so a key cannot run away with the bill. Defaults: 20 requests,
# 120000 characters, 60 seconds per request. `--dry-run` prints the request and sends nothing.
SPEECH_NOTES_GEMINI_MAX_REQUESTS=
SPEECH_NOTES_GEMINI_MAX_CHARS=
SPEECH_NOTES_GEMINI_TIMEOUT_SECONDS=

## Read by scripts/download_model.sh and scripts/run_eval.sh (not by the app)

# Where models are extracted. Default: models (the CLI looks in models/vosk-model-small-en-us-0.15
# unless you pass --model <dir>).
SPEECH_NOTES_MODELS_DIR=

# A local copy of the pinned zip, for a machine with no network. Checksum is still verified.
SPEECH_NOTES_MODEL_ZIP=
